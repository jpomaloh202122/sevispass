{
  "name": "@digital-id/core-stack",
  "version": "1.0.0",
  "description": "A comprehensive, modular digital identity platform built from SevisPass implementation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:auth\" \"npm run dev:verification\" \"npm run dev:credentials\" \"npm run dev:api-gateway\"",
    "dev:auth": "nodemon modules/auth/src/server.ts",
    "dev:verification": "nodemon modules/verification/src/server.ts",
    "dev:credentials": "nodemon modules/credentials/src/server.ts",
    "dev:api-gateway": "nodemon modules/api-gateway/src/server.ts",
    "build": "npm run build:auth && npm run build:verification && npm run build:credentials && npm run build:api-gateway && npm run build:sdk",
    "build:auth": "tsc -p modules/auth/tsconfig.json",
    "build:verification": "tsc -p modules/verification/tsconfig.json",
    "build:credentials": "tsc -p modules/credentials/tsconfig.json",
    "build:api-gateway": "tsc -p modules/api-gateway/tsconfig.json",
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "node scripts/migrate-database.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy:dev": "npm run build && npm run docker:build && npm run docker:up",
    "deploy:prod": "npm run build && docker-compose -f docker-compose.prod.yml up -d"
  },
  "keywords": [
    "digital-identity",
    "authentication",
    "biometric-verification",
    "verifiable-credentials",
    "oidc",
    "jwt",
    "blockchain",
    "identity-management"
  ],
  "author": "Digital ID Core Stack Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.879.0",
    "@aws-sdk/client-textract": "^3.879.0",
    "@supabase/supabase-js": "^2.55.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "canvas": "^3.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "oidc-provider": "^9.5.1",
    "qrcode": "^1.5.4",
    "redis": "^4.6.12",
    "sharp": "^0.34.3",
    "uuid": "^12.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/oidc-provider": "^9.5.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/digital-id-core-stack.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/digital-id-core-stack/issues"
  },
  "homepage": "https://github.com/your-org/digital-id-core-stack#readme"
}

